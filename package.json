{
  "name": "songascribe",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint app server shared nuxt.config.ts drizzle.config.ts eslint.config.mjs vitest.config.ts tests --no-ignore",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:up": "npm run db:migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@iconify-json/mdi": "1.2.3",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/icon": "2.3.1",
    "@nuxt/test-utils": "^4.0.3",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "daisyui": "5.6.18",
    "drizzle-kit": "0.31.10",
    "eslint": "10.7.0",
    "nuxt": "4.4.8",
    "nuxt-auth-utils": "0.5.29",
    "tailwindcss": "4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "h3": "1.15.11"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=11"
  }
