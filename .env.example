# SQLite database file. Compose overrides this with /data/sqlite.db.
DATABASE_PATH=./data/sqlite.db

# Required by nuxt-auth-utils. Use a random value of at least 32 characters.
NUXT_SESSION_PASSWORD=

# NodeLink connection used by local development.
NODELINK_HOST=localhost
NODELINK_PORT=2333
NODELINK_PASSWORD=
NODELINK_TIMEOUT_MS=8000
